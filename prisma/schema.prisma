// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Engineering Lab (B1/B2/B3 waves) — lab run persistence, recommendations,
// bridge entries, calibration observations. Reconstructed from the lab API
// source usage (src/app/api/lab/**) after the 2026-10-04 reset wiped the
// evolved my-project that carried the original schema.
// ---------------------------------------------------------------------------

model LabRun {
  id          String   @id @default(cuid())
  workloadId  String
  taskTypeId  String
  scenarioId  String
  ladderLevel Int
  seeds       String
  status      String
  artifact    String
  error       String?
  createdAt   DateTime @default(now())
}

model LabRecommendation {
  id        String   @id @default(cuid())
  runId     String
  status    String
  artifact  String
  createdAt DateTime @default(now())
}

model LabBridgeEntry {
  id              String    @id @default(cuid())
  recommendationId String
  status          String
  note            String
  portMode        String
  observation     String?
  observedAt      DateTime?
  submittedAt     DateTime  @default(now())
  createdAt       DateTime  @default(now())
}

model LabCalibrationObservation {
  id            String   @id @default(cuid())
  bridgeEntryId String
  predicted     String
  observed      String
  error         String
  createdAt     DateTime @default(now())
}